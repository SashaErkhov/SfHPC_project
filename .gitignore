# ==========================================
# Бинарники, артефакты сборки и объектные файлы
# ==========================================
# Объектные файлы и библиотеки
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll

# Файлы статического анализа (GCC/Clang)
*.gch
*.pch

# Детекция зависимостей
*.d

# Финальные исполняемые файлы (компилируемые бинарники)
# (Если у тебя исполняемый файл без расширения, лучше запускать сборку в отдельную папку, см. ниже)
*.exe
*.out
*.app

# ==========================================
# Системы сборки (Build Systems)
# ==========================================
# Папки сборки общего назначения (стандарт для CMake, Meson и др.)
[Bb]uild/
[Cc]make-build-*/

# Файлы CMake (если генерируются в корне, а не в папке build)
CMakeCache.txt
CMakeFiles/
CMakeMembers.txt
cmake_install.cmake
Makefile
targets.make

# Файлы автоконфигурации (Autotools)
.deps/
.libs/
*.la
*.lo

# ==========================================
# Инструменты разработки и IDE
# ==========================================
# Visual Studio
.vs/
Debug/
Release/
x64/
x86/
[Dd]ebug/
[Rr]elease/
*.suo
*.user
*.userosscache
*.sln.docstates

# CLion / Rider / JetBrains
.idea/

# VS Code
.vscode/
# Исключение: если ты хочешь сохранить настройки проекта для команды, 
# то раскомментируй строку ниже, но заигнорь личные конфиги:
# !.vscode/settings.json

# Qt Creator
*.user
*.user.*

# ==========================================
# Логи, дампы и профилирование
# ==========================================
*.log
*.gcov
*.gcda
*.gcno
*.profraw
*.profdata
